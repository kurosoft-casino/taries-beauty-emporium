{
  "name": "taries-beauty-emporium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "bash ./scripts/build-static.sh",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:d1:local": "wrangler d1 execute taries-beauty-emporium --local --file=./cloudflare/schema.sql",
    "cf:d1:remote": "wrangler d1 execute taries-beauty-emporium --remote --file=./cloudflare/schema.sql"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "postcss": "8.5.10",
    "tailwindcss": "^3",
    "typescript": "^5",
    "wrangler": "^4.84.1"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
