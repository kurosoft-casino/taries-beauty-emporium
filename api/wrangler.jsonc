{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taries-beauty-api",
  "main": "src/index.js",
  "compatibility_date": "2026-04-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "routes": [
    {
      "pattern": "www.tariesbeauty.com/api/*",
      "zone_name": "tariesbeauty.com"
    },
    {
      "pattern": "tariesbeauty.com/api/*",
      "zone_name": "tariesbeauty.com"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://tariesbeauty.com,https://www.tariesbeauty.com,http://tariesbeauty.com,http://www.tariesbeauty.com,https://kurosoft1.github.io,http://localhost:3000",
    "PUBLIC_SITE_URL": "https://www.tariesbeauty.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taries-beauty-emporium",
      "database_id": "bb8506ed-174f-4db4-b8f2-981d66ad2ad6"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "b03da41c33aa4b24918e4d9428fe1be5"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
