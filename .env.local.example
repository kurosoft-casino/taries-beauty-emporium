NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SITE_URL=https://www.tariesbeauty.com

# Comma-separated list of origins allowed by the API CORS layer
ALLOWED_ORIGINS=https://tariesbeauty.com,https://www.tariesbeauty.com,http://localhost:3000

# Public site URL used for Flutterwave payment redirects
PUBLIC_SITE_URL=https://www.tariesbeauty.com

# PocketBase (server-side only — never expose to the browser)
PB_URL=https://hub.kurosofthub.com
PB_SUPERUSER_EMAIL=taries-app@kurosofthub.com
PB_SUPERUSER_PASSWORD=

# Flutterwave payments (server-side only)
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=

# Resend transactional email (server-side only; emails no-op when unset)
RESEND_API_KEY=
